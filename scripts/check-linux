#!/bin/bash

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
WHITE='\033[1;37m'
NC='\033[0m'

print_header() {
    echo -e "${BLUE}--- $1 ---${NC}"
}

clear
echo -e "${WHITE}"
echo "════════════════════════════════════════════════════════════"
echo "      🐧  LINUX DISTRIBUTION DETECTION                      "
echo "════════════════════════════════════════════════════════════"
echo -e "${NC}"

detect_distribution() {
    if [ -f /etc/os-release ]; then
        . /etc/os-release
        echo -e "${GREEN}✓ Distribution:${NC} $NAME"
        echo -e "${GREEN}✓ Version:${NC} $VERSION_ID"
        echo -e "${GREEN}✓ ID:${NC} $ID"
        return 0
    fi

    if [ -f /etc/lsb-release ]; then
        . /etc/lsb-release
        echo -e "${GREEN}✓ Distribution:${NC} $DISTRIB_ID"
        echo -e "${GREEN}✓ Version:${NC} $DISTRIB_RELEASE"
        return 0
    fi

    if [ -f /etc/redhat-release ]; then
        echo -e "${GREEN}✓ Distribution:${NC} $(cat /etc/redhat-release)"
        return 0
    fi

    if [ -f /etc/system-release ]; then
        echo -e "${GREEN}✓ Distribution:${NC} $(cat /etc/system-release)"
        return 0
    fi

    if [ -f /etc/debian_version ]; then
        echo -e "${GREEN}✓ Distribution:${NC} Debian"
        echo -e "${GREEN}✓ Version:${NC} $(cat /etc/debian_version)"
        return 0
    fi

    echo -e "${YELLOW}⚠ Could not determine distribution${NC}"
    uname -a
}

print_header "DISTRIBUTION INFORMATION"
detect_distribution

echo ""
print_header "KERNEL INFORMATION"
echo -e "${GREEN}✓ Kernel:${NC} $(uname -r)"
echo -e "${GREEN}✓ Architecture:${NC} $(uname -m)"

echo ""
print_header "PACKAGE MANAGER"
if command -v apt &>/dev/null; then
    echo -e "${GREEN}✓ Package Manager:${NC} APT"
elif command -v yum &>/dev/null; then
    echo -e "${GREEN}✓ Package Manager:${NC} YUM"
elif command -v dnf &>/dev/null; then
    echo -e "${GREEN}✓ Package Manager:${NC} DNF"
elif command -v pacman &>/dev/null; then
    echo -e "${GREEN}✓ Package Manager:${NC} PACMAN"
else
    echo -e "${YELLOW}⚠ Unknown package manager${NC}"
fi

echo ""
echo "=========================================="