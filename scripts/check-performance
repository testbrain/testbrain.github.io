#!/bin/bash

# ============================================
# Performance Benchmark Script
# Comprehensive system performance testing
# ============================================

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
WHITE='\033[1;37m'
NC='\033[0m'

print_header() {
    echo -e "\n${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${WHITE}  $1${NC}"
    echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
}

print_info() {
    printf "${GREEN}►${NC} ${CYAN}%-20s${NC} %s\n" "$1:" "$2"
}

print_success() {
    echo -e "${GREEN}✓ $1${NC}"
}

print_warning() {
    echo -e "${YELLOW}⚠ $1${NC}"
}

clear
echo -e "${WHITE}"
echo "════════════════════════════════════════════════════════════"
echo "      ⚡  PERFORMANCE BENCHMARK REPORT                       "
echo "════════════════════════════════════════════════════════════"
echo -e "${NC}"

# --------------------------------------------
# 1. SYSTEM INFORMATION
# --------------------------------------------
print_header "SYSTEM INFORMATION"

# CPU Info
cpu_model=$(grep "model name" /proc/cpuinfo | head -1 | cut -d: -f2 | sed 's/^ //')
cpu_cores=$(grep -c "^processor" /proc/cpuinfo)
print_info "CPU" "$cpu_model"
print_info "Cores" "$cpu_cores"

# Memory
total_mem=$(free -h | awk '/^Mem:/ {print $2}')
print_info "Total RAM" "$total_mem"

# Disk
disk_size=$(df -h / | awk 'NR==2 {print $2}')
print_info "Root Disk" "$disk_size"

# --------------------------------------------
# 2. CPU PERFORMANCE
# --------------------------------------------
print_header "CPU PERFORMANCE"

echo -e "${CYAN}►${NC} ${WHITE}CPU Benchmark (single-thread):${NC}"
start=$(date +%s%N)
for i in $(seq 1 1000000); do
    echo "scale=10; $i * 3.14159" | bc -l 2>/dev/null > /dev/null
done
end=$(date +%s%N)
time_ms=$(echo "scale=2; ($end - $start) / 1000000" | bc)
echo -e "  ${WHITE}1M floating point operations:${NC} ${YELLOW}${time_ms}ms${NC}"

echo -e "\n${CYAN}►${NC} ${WHITE}CPU Benchmark (multi-thread):${NC}"
start=$(date +%s%N)
for i in $(seq 1 100000); do
    sha256sum /dev/null 2>/dev/null > /dev/null
done
end=$(date +%s%N)
time_ms=$(echo "scale=2; ($end - $start) / 1000000" | bc)
echo -e "  ${WHITE}100K hash operations:${NC} ${YELLOW}${time_ms}ms${NC}"

# CPU performance score
echo -e "\n${CYAN}►${NC} ${WHITE}CPU Performance Score:${NC}"
if [ "$time_ms" -lt 500 ]; then
    echo -e "  ${GREEN}Excellent${NC}"
elif [ "$time_ms" -lt 1000 ]; then
    echo -e "  ${YELLOW}Good${NC}"
else
    echo -e "  ${RED}Slow${NC}"
fi

# --------------------------------------------
# 3. MEMORY PERFORMANCE
# --------------------------------------------
print_header "MEMORY PERFORMANCE"

echo -e "${CYAN}►${NC} ${WHITE}Memory speed test:${NC}"

# Write speed
echo -e "\n  ${WHITE}Write speed:${NC}"
start=$(date +%s%N)
dd if=/dev/zero of=/tmp/memtest bs=1M count=100 2>/dev/null
end=$(date +%s%N)
write_speed=$(echo "scale=2; 100 / (($end - $start) / 1000000000)" | bc)
echo -e "    ${GREEN}${write_speed} MB/s${NC}"

# Read speed
echo -e "\n  ${WHITE}Read speed:${NC}"
start=$(date +%s%N)
dd if=/tmp/memtest of=/dev/null bs=1M 2>/dev/null
end=$(date +%s%N)
read_speed=$(echo "scale=2; 100 / (($end - $start) / 1000000000)" | bc)
echo -e "    ${GREEN}${read_speed} MB/s${NC}"

# Cleanup
rm -f /tmp/memtest

# Memory latency (simple)
echo -e "\n  ${WHITE}Memory access latency:${NC}"
start=$(date +%s%N)
for i in $(seq 1 10000); do
    echo "$i" > /dev/null
done
end=$(date +%s%N)
latency=$(echo "scale=2; ($end - $start) / 10000" | bc)
echo -e "    ${YELLOW}${latency} ms per operation${NC}"

# --------------------------------------------
# 4. DISK PERFORMANCE
# --------------------------------------------
print_header "DISK PERFORMANCE"

# Create test file
dd if=/dev/zero of=/tmp/perf_test bs=1M count=512 2>/dev/null

echo -e "${CYAN}►${NC} ${WHITE}Disk Write Speed:${NC}"
start=$(date +%s%N)
dd if=/dev/zero of=/tmp/perf_test bs=1M count=512 conv=fdatasync 2>/dev/null
end=$(date +%s%N)
write_speed=$(echo "scale=2; 512 / (($end - $start) / 1000000000)" | bc)
echo -e "  ${GREEN}${write_speed} MB/s${NC}"

echo -e "\n${CYAN}►${NC} ${WHITE}Disk Read Speed:${NC}"
start=$(date +%s%N)
dd if=/tmp/perf_test of=/dev/null bs=1M 2>/dev/null
end=$(date +%s%N)
read_speed=$(echo "scale=2; 512 / (($end - $start) / 1000000000)" | bc)
echo -e "  ${GREEN}${read_speed} MB/s${NC}"

# Cleanup
rm -f /tmp/perf_test

# Disk IOPS (simplified)
echo -e "\n${CYAN}►${NC} ${WHITE}Disk IOPS (4K random writes):${NC}"
start=$(date +%s%N)
for i in $(seq 1 1000); do
    dd if=/dev/urandom of=/tmp/iops_test bs=4k count=1 2>/dev/null
done
end=$(date +%s%N)
iops=$(echo "scale=2; 1000 / (($end - $start) / 1000000000)" | bc)
echo -e "  ${YELLOW}${iops} IOPS${NC}"
rm -f /tmp/iops_test

# --------------------------------------------
# 5. NETWORK PERFORMANCE
# --------------------------------------------
print_header "NETWORK PERFORMANCE"

# Download speed test (if possible)
echo -e "${CYAN}►${NC} ${WHITE}Network Download Speed:${NC}"
echo -e "  ${YELLOW}Testing...${NC}"

# Simple download test
start=$(date +%s%N)
curl -s --max-time 5 -o /dev/null http://speedtest.tele2.net/1MB.zip 2>/dev/null
end=$(date +%s%N)
time_sec=$(echo "scale=2; ($end - $start) / 1000000000" | bc)
if [ "$(echo "$time_sec > 0" | bc)" -eq 1 ]; then
    speed=$(echo "scale=2; 1 / $time_sec" | bc)
    echo -e "  ${GREEN}${speed} MB/s${NC}"
else
    echo -e "  ${YELLOW}Speed test unavailable${NC}"
fi

# Latency to common hosts
echo -e "\n${CYAN}►${NC} ${WHITE}Network Latency:${NC}"
for host in "8.8.8.8" "1.1.1.1" "9.9.9.9"; do
    ping_result=$(ping -c 1 -W 2 "$host" 2>/dev/null | tail -1 | awk -F'=' '{print $4}' | cut -d' ' -f1)
    if [ -n "$ping_result" ]; then
        if [ "$(echo "$ping_result < 50" | bc)" -eq 1 ]; then
            echo -e "  ${GREEN}$host${NC}: ${WHITE}${ping_result}ms${NC}"
        elif [ "$(echo "$ping_result < 150" | bc)" -eq 1 ]; then
            echo -e "  ${YELLOW}$host${NC}: ${WHITE}${ping_result}ms${NC}"
        else
            echo -e "  ${RED}$host${NC}: ${WHITE}${ping_result}ms${NC}"
        fi
    fi
done

# --------------------------------------------
# 6. OVERALL PERFORMANCE SCORE
# --------------------------------------------
print_header "PERFORMANCE SCORE"

score=0
max_score=20

# CPU Score
if [ "$(echo "$time_ms < 500" | bc)" -eq 1 ]; then
    score=$((score + 5))
    cpu_grade="Excellent"
elif [ "$(echo "$time_ms < 1000" | bc)" -eq 1 ]; then
    score=$((score + 3))
    cpu_grade="Good"
else
    score=$((score + 1))
    cpu_grade="Fair"
fi

# Memory Score
if [ "$(echo "$write_speed > 500" | bc)" -eq 1 ]; then
    score=$((score + 5))
    mem_grade="Excellent"
elif [ "$(echo "$write_speed > 200" | bc)" -eq 1 ]; then
    score=$((score + 3))
    mem_grade="Good"
else
    score=$((score + 1))
    mem_grade="Fair"
fi

# Disk Score
if [ "$(echo "$write_speed > 200" | bc)" -eq 1 ] && [ "$(echo "$read_speed > 300" | bc)" -eq 1 ]; then
    score=$((score + 5))
    disk_grade="Excellent"
elif [ "$(echo "$write_speed > 100" | bc)" -eq 1 ] && [ "$(echo "$read_speed > 150" | bc)" -eq 1 ]; then
    score=$((score + 3))
    disk_grade="Good"
else
    score=$((score + 1))
    disk_grade="Fair"
fi

# Network Score
if [ "$(echo "$ping_result < 50" | bc)" -eq 1 ]; then
    score=$((score + 5))
    net_grade="Excellent"
elif [ "$(echo "$ping_result < 150" | bc)" -eq 1 ]; then
    score=$((score + 3))
    net_grade="Good"
else
    score=$((score + 1))
    net_grade="Fair"
fi

echo -e "${WHITE}Performance Breakdown:${NC}"
echo -e "  ${CYAN}CPU:${NC}     $cpu_grade"
echo -e "  ${CYAN}Memory:${NC}  $mem_grade"
echo -e "  ${CYAN}Disk:${NC}    $disk_grade"
echo -e "  ${CYAN}Network:${NC} $net_grade"

echo -e "\n${WHITE}Overall Score:${NC} ${score}/${max_score}"

if [ "$score" -ge 16 ]; then
    echo -e "${GREEN}✓ Excellent performance${NC}"
elif [ "$score" -ge 10 ]; then
    echo -e "${YELLOW}⚠ Good performance${NC}"
else
    echo -e "${RED}✗ Performance could be improved${NC}"
fi

echo -e "\n${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${GREEN}✓ Performance benchmark complete${NC}"
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}\n"