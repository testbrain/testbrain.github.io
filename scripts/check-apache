#!/bin/bash

# ============================================
# Apache Health Check Script
# Comprehensive Apache monitoring and configuration check
# ============================================

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
WHITE='\033[1;37m'
NC='\033[0m'

print_header() {
    echo -e "\n${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${WHITE}  $1${NC}"
    echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
}

print_info() {
    printf "${GREEN}►${NC} ${CYAN}%-20s${NC} %s\n" "$1:" "$2"
}

print_success() {
    echo -e "${GREEN}✓ $1${NC}"
}

print_warning() {
    echo -e "${YELLOW}⚠ $1${NC}"
}

print_error() {
    echo -e "${RED}✗ $1${NC}"
}

clear
echo -e "${WHITE}"
echo "════════════════════════════════════════════════════════════"
echo "      🌐  APACHE HEALTH REPORT                              "
echo "════════════════════════════════════════════════════════════"
echo -e "${NC}"

# --------------------------------------------
# 1. APACHE STATUS
# --------------------------------------------
print_header "APACHE STATUS"

# Check both Apache2 and Httpd
for service in apache2 httpd; do
    if command -v "$service" &>/dev/null || systemctl list-units | grep -q "$service"; then
        APACHE_SERVICE="$service"
        break
    fi
done

if [ -z "$APACHE_SERVICE" ]; then
    print_error "Apache is not installed"
    exit 1
fi

# Check service
if systemctl is-active --quiet "$APACHE_SERVICE" 2>/dev/null; then
    print_success "Apache: Running ($APACHE_SERVICE)"
else
    print_error "Apache: Not running"
fi

# Apache version
if command -v apache2 &>/dev/null; then
    version=$(apache2 -v 2>&1 | head -1)
elif command -v httpd &>/dev/null; then
    version=$(httpd -v 2>&1 | head -1)
fi
[ -n "$version" ] && print_info "Version" "$version"

# --------------------------------------------
# 2. APACHE CONFIGURATION
# --------------------------------------------
print_header "CONFIGURATION CHECK"

# Config test
if command -v apache2 &>/dev/null; then
    config_test=$(apache2ctl configtest 2>&1)
elif command -v httpd &>/dev/null; then
    config_test=$(httpd -t 2>&1)
fi

if echo "$config_test" | grep -q "Syntax OK"; then
    print_success "Configuration syntax: OK"
else
    print_error "Configuration error:"
    echo "$config_test"
fi

# Config files
echo -e "\n${CYAN}►${NC} ${WHITE}Configuration files:${NC}"
if [ -d /etc/apache2 ]; then
    find /etc/apache2 -name "*.conf" 2>/dev/null | while read file; do
        echo -e "  ${GREEN}$file${NC}"
    done | head -10
elif [ -d /etc/httpd ]; then
    find /etc/httpd -name "*.conf" 2>/dev/null | while read file; do
        echo -e "  ${GREEN}$file${NC}"
    done | head -10
fi

# --------------------------------------------
# 3. MODULES
# --------------------------------------------
print_header "LOADED MODULES"

echo -e "${CYAN}►${NC} ${WHITE}Loaded modules:${NC}"
if command -v apache2 &>/dev/null; then
    apache2 -M 2>/dev/null | grep -v "Loaded Modules" | while read module; do
        echo -e "  ${GREEN}$module${NC}"
    done
elif command -v httpd &>/dev/null; then
    httpd -M 2>/dev/null | grep -v "Loaded Modules" | while read module; do
        echo -e "  ${GREEN}$module${NC}"
    done
fi

# Check critical modules
echo -e "\n${CYAN}►${NC} ${WHITE}Critical modules check:${NC}"
critical_modules=("mod_ssl" "mod_rewrite" "mod_headers" "mod_security" "mod_expires" "mod_deflate")

for mod in "${critical_modules[@]}"; do
    if apache2 -M 2>/dev/null | grep -q "$mod" || httpd -M 2>/dev/null | grep -q "$mod"; then
        echo -e "  ${GREEN}✓${NC} $mod"
    else
        echo -e "  ${YELLOW}✗${NC} $mod (not loaded)"
    fi
done

# --------------------------------------------
# 4. VIRTUAL HOSTS
# --------------------------------------------
print_header "VIRTUAL HOSTS"

# Find virtual hosts
echo -e "${CYAN}►${NC} ${WHITE}Active virtual hosts:${NC}"
if [ -d /etc/apache2/sites-enabled ]; then
    for site in /etc/apache2/sites-enabled/*; do
        if [ -f "$site" ]; then
            site_name=$(basename "$site")
            server_name=$(grep "ServerName" "$site" 2>/dev/null | grep -v "#" | awk '{print $2}' | head -1)
            server_admin=$(grep "ServerAdmin" "$site" 2>/dev/null | grep -v "#" | awk '{print $2}' | head -1)
            document_root=$(grep "DocumentRoot" "$site" 2>/dev/null | grep -v "#" | awk '{print $2}' | head -1)
            echo -e "  ${GREEN}$site_name${NC}: ${WHITE}${server_name:-default}${NC}"
            [ -n "$document_root" ] && echo -e "    Root: ${CYAN}$document_root${NC}"
        fi
    done
elif [ -d /etc/httpd/conf.d ]; then
    for site in /etc/httpd/conf.d/*.conf; do
        if [ -f "$site" ]; then
            site_name=$(basename "$site")
            server_name=$(grep "ServerName" "$site" 2>/dev/null | grep -v "#" | awk '{print $2}' | head -1)
            echo -e "  ${GREEN}$site_name${NC}: ${WHITE}${server_name:-default}${NC}"
        fi
    done
else
    print_warning "No virtual hosts directory found"
fi

# --------------------------------------------
# 5. SSL CERTIFICATES
# --------------------------------------------
print_header "SSL CERTIFICATES"

# Find SSL certificates
echo -e "${CYAN}►${NC} ${WHITE}SSL certificates in use:${NC}"
grep -r "SSLCertificateFile" /etc/apache2/ /etc/httpd/ 2>/dev/null | grep -v "#" | while read line; do
    cert_path=$(echo "$line" | awk '{print $2}')
    if [ -f "$cert_path" ]; then
        expiry=$(openssl x509 -enddate -noout -in "$cert_path" 2>/dev/null | cut -d= -f2)
        if [ -n "$expiry" ]; then
            days_left=$(( ($(date -d "$expiry" +%s) - $(date +%s)) / 86400 ))
            if [ "$days_left" -lt 7 ]; then
                echo -e "  ${RED}$cert_path${NC}: ${YELLOW}$days_left days${NC}"
            elif [ "$days_left" -lt 30 ]; then
                echo -e "  ${YELLOW}$cert_path${NC}: ${YELLOW}$days_left days${NC}"
            else
                echo -e "  ${GREEN}$cert_path${NC}: ${WHITE}$days_left days${NC}"
            fi
        fi
    else
        echo -e "  ${RED}$cert_path (missing)${NC}"
    fi
done

# --------------------------------------------
# 6. LOGS & ERRORS
# --------------------------------------------
print_header "LOGS & ERRORS"

# Error log location
error_log=$(grep "ErrorLog" /etc/apache2/apache2.conf /etc/httpd/conf/httpd.conf 2>/dev/null | grep -v "#" | head -1 | awk '{print $2}')
[ -n "$error_log" ] && print_info "Error Log" "$error_log"

# Access log location
access_log=$(grep "CustomLog" /etc/apache2/apache2.conf /etc/httpd/conf/httpd.conf 2>/dev/null | grep -v "#" | head -1 | awk '{print $2}')
[ -n "$access_log" ] && print_info "Access Log" "$access_log"

# Recent errors
if [ -f "$error_log" ]; then
    echo -e "\n${CYAN}►${NC} ${WHITE}Recent errors (last 5):${NC}"
    tail -5 "$error_log" 2>/dev/null | while read line; do
        if echo "$line" | grep -qi "error"; then
            echo -e "  ${RED}$line${NC}"
        elif echo "$line" | grep -qi "warn"; then
            echo -e "  ${YELLOW}$line${NC}"
        else
            echo -e "  $line"
        fi
    done
fi

# --------------------------------------------
# 7. PERFORMANCE METRICS
# --------------------------------------------
print_header "PERFORMANCE METRICS"

# Check if mod_status is enabled
if apache2 -M 2>/dev/null | grep -q "status_module" || httpd -M 2>/dev/null | grep -q "status_module"; then
    echo -e "${CYAN}►${NC} ${WHITE}Status module is enabled${NC}"
    
    # Try to get status
    if curl -s --max-time 2 http://localhost/server-status 2>/dev/null | grep -q "Apache Server Status"; then
        echo -e "\n${CYAN}►${NC} ${WHITE}Server status:${NC}"
        curl -s http://localhost/server-status 2>/dev/null | grep -E "BusyWorkers|IdleWorkers|CPU|Requests" | head -10
    fi
else
    echo -e "${CYAN}►${NC} ${WHITE}Status module not enabled${NC}"
    echo -e "  ${YELLOW}Enable mod_status for detailed metrics${NC}"
fi

# --------------------------------------------
# 8. APACHE SECURITY
# --------------------------------------------
print_header "SECURITY CHECK"

# Check server signature
if grep -q "ServerSignature Off" /etc/apache2/apache2.conf /etc/httpd/conf/httpd.conf 2>/dev/null; then
    echo -e "  ${GREEN}✓${NC} ServerSignature disabled"
else
    echo -e "  ${YELLOW}✗${NC} ServerSignature not disabled"
fi

# Check server tokens
if grep -q "ServerTokens Prod" /etc/apache2/apache2.conf /etc/httpd/conf/httpd.conf 2>/dev/null; then
    echo -e "  ${GREEN}✓${NC} ServerTokens set to Prod"
else
    echo -e "  ${YELLOW}✗${NC} ServerTokens not set to Prod"
fi

# Check directory listing
if grep -r "Options -Indexes" /etc/apache2/ /etc/httpd/ 2>/dev/null | grep -v "#" > /dev/null; then
    echo -e "  ${GREEN}✓${NC} Directory listing disabled"
else
    echo -e "  ${YELLOW}✗${NC} Directory listing may be enabled"
fi

# Check for mod_security
if apache2 -M 2>/dev/null | grep -q "security2_module" || httpd -M 2>/dev/null | grep -q "security2_module"; then
    echo -e "  ${GREEN}✓${NC} mod_security enabled"
else
    echo -e "  ${YELLOW}✗${NC} mod_security not enabled (recommended)"
fi

# --------------------------------------------
# 9. RECOMMENDATIONS
# --------------------------------------------
print_header "RECOMMENDATIONS"

# Check for common issues
if ! grep -q "ServerTokens Prod" /etc/apache2/apache2.conf /etc/httpd/conf/httpd.conf 2>/dev/null; then
    echo -e "  ${YELLOW}→${NC} Set 'ServerTokens Prod' to hide version information"
fi

if ! grep -q "ServerSignature Off" /etc/apache2/apache2.conf /etc/httpd/conf/httpd.conf 2>/dev/null; then
    echo -e "  ${YELLOW}→${NC} Set 'ServerSignature Off' to hide server details"
fi

if ! grep -r "Options -Indexes" /etc/apache2/ /etc/httpd/ 2>/dev/null | grep -v "#" > /dev/null; then
    echo -e "  ${YELLOW}→${NC} Disable directory listing with 'Options -Indexes'"
fi

if ! apache2 -M 2>/dev/null | grep -q "security2_module" && ! httpd -M 2>/dev/null | grep -q "security2_module"; then
    echo -e "  ${YELLOW}→${NC} Install and enable mod_security for WAF protection"
fi

# Check for backup config
if [ -f /etc/apache2/apache2.conf.default ] || [ -f /etc/httpd/conf/httpd.conf.default ]; then
    echo -e "  ${GREEN}✓${NC} Backup config found"
else
    echo -e "  ${YELLOW}→${NC} Backup your Apache configuration"
fi

echo -e "\n${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${GREEN}✓ Apache health check complete${NC}"
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}\n"