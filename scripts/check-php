#!/bin/bash

# ============================================
# PHP Information Script
# Comprehensive PHP configuration checker
# ============================================

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
WHITE='\033[1;37m'
NC='\033[0m'

print_header() {
    echo -e "\n${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${WHITE}  $1${NC}"
    echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
}

print_info() {
    printf "${GREEN}►${NC} ${CYAN}%-20s${NC} %s\n" "$1:" "$2"
}

print_warning() {
    echo -e "${YELLOW}⚠ $1${NC}"
}

print_success() {
    echo -e "${GREEN}✓ $1${NC}"
}

clear
echo -e "${WHITE}"
echo "════════════════════════════════════════════════════════════"
echo "      🐘  PHP INFORMATION REPORT                            "
echo "════════════════════════════════════════════════════════════"
echo -e "${NC}"

# --------------------------------------------
# 1. PHP VERSIONS
# --------------------------------------------
print_header "PHP VERSIONS"

# Find all PHP versions
php_versions=$(find /usr/bin /usr/local/bin -name "php*" -type f -executable 2>/dev/null | grep -E "php[0-9]" | sort -u)
if [ -n "$php_versions" ]; then
    echo -e "${CYAN}►${NC} ${WHITE}Installed PHP versions:${NC}"
    for php in $php_versions; do
        version=$($php -v 2>/dev/null | head -1 | awk '{print $2}')
        if [ -n "$version" ]; then
            echo -e "  ${GREEN}$php${NC}: ${WHITE}$version${NC}"
        fi
    done
else
    print_warning "No PHP versions found in /usr/bin or /usr/local/bin"
fi

# Default PHP version
if command -v php &>/dev/null; then
    default_php=$(php -v 2>/dev/null | head -1)
    echo -e "\n${CYAN}►${NC} ${WHITE}Default PHP version:${NC}"
    echo -e "  ${GREEN}$default_php${NC}"
else
    print_warning "PHP not found in PATH"
fi

# --------------------------------------------
# 2. PHP CONFIGURATION
# --------------------------------------------
print_header "PHP CONFIGURATION"

if command -v php &>/dev/null; then
    # Configuration file
    php_ini=$(php --ini 2>/dev/null | grep "Loaded Configuration File" | awk '{print $4}')
    print_info "php.ini" "$php_ini"
    
    # Key settings
    echo -e "\n${CYAN}►${NC} ${WHITE}Key PHP settings:${NC}"
    
    settings=(
        "memory_limit"
        "max_execution_time"
        "max_input_time"
        "upload_max_filesize"
        "post_max_size"
        "max_file_uploads"
        "error_reporting"
        "display_errors"
        "log_errors"
        "error_log"
        "session.save_path"
        "upload_tmp_dir"
        "date.timezone"
        "allow_url_fopen"
        "disable_functions"
    )
    
    for setting in "${settings[@]}"; do
        value=$(php -r "echo ini_get('$setting');" 2>/dev/null)
        if [ -n "$value" ]; then
            # Color code based on values
            if [ "$setting" = "memory_limit" ]; then
                mem_val=$(echo "$value" | sed 's/[^0-9]*//g')
                if [ "$mem_val" -ge 256 ]; then
                    echo -e "  ${GREEN}$setting${NC}: ${WHITE}$value${NC}"
                elif [ "$mem_val" -ge 128 ]; then
                    echo -e "  ${YELLOW}$setting${NC}: ${WHITE}$value${NC}"
                else
                    echo -e "  ${RED}$setting${NC}: ${WHITE}$value${NC}"
                fi
            elif [ "$setting" = "display_errors" ]; then
                if [ "$value" = "1" ] || [ "$value" = "On" ]; then
                    echo -e "  ${RED}$setting${NC}: ${WHITE}$value (should be Off in production)${NC}"
                else
                    echo -e "  ${GREEN}$setting${NC}: ${WHITE}$value${NC}"
                fi
            elif [ "$setting" = "upload_max_filesize" ]; then
                size_val=$(echo "$value" | sed 's/[^0-9]*//g')
                if [ "$size_val" -ge 64 ]; then
                    echo -e "  ${GREEN}$setting${NC}: ${WHITE}$value${NC}"
                elif [ "$size_val" -ge 32 ]; then
                    echo -e "  ${YELLOW}$setting${NC}: ${WHITE}$value${NC}"
                else
                    echo -e "  ${YELLOW}$setting${NC}: ${WHITE}$value (consider increasing)${NC}"
                fi
            else
                echo -e "  ${CYAN}$setting${NC}: ${WHITE}$value${NC}"
            fi
        fi
    done
fi

# --------------------------------------------
# 3. PHP EXTENSIONS
# --------------------------------------------
print_header "PHP EXTENSIONS"

if command -v php &>/dev/null; then
    # List all extensions
    echo -e "${CYAN}►${NC} ${WHITE}Loaded extensions:${NC}"
    php -m 2>/dev/null | grep -v "PHP" | grep -v "^$" | sort | while read ext; do
        echo -e "  ${GREEN}$ext${NC}"
    done
    
    # Check important extensions
    echo -e "\n${CYAN}►${NC} ${WHITE}Critical extensions check:${NC}"
    critical_extensions=("mysql" "mysqli" "pdo" "pdo_mysql" "mbstring" "xml" "json" "curl" "gd" "openssl" "zip" "exif" "fileinfo" "intl")
    
    for ext in "${critical_extensions[@]}"; do
        if php -m 2>/dev/null | grep -q "^$ext$"; then
            echo -e "  ${GREEN}✓${NC} $ext"
        else
            echo -e "  ${RED}✗${NC} $ext ${YELLOW}(not installed)${NC}"
        fi
    done
fi

# --------------------------------------------
# 4. PHP-FPM STATUS
# --------------------------------------------
print_header "PHP-FPM STATUS"

if systemctl list-units 2>/dev/null | grep -q "php.*fpm"; then
    echo -e "${CYAN}►${NC} ${WHITE}PHP-FPM services:${NC}"
    systemctl list-units 2>/dev/null | grep "php.*fpm" | while read line; do
        service=$(echo "$line" | awk '{print $1}')
        status=$(echo "$line" | awk '{print $3}')
        if [ "$status" = "running" ] || [ "$status" = "active" ]; then
            echo -e "  ${GREEN}●${NC} $service ${GREEN}($status)${NC}"
        else
            echo -e "  ${RED}●${NC} $service ${RED}($status)${NC}"
        fi
    done
else
    print_warning "No PHP-FPM services found"
fi

# PHP-FPM pools
if command -v php-fpm &>/dev/null; then
    echo -e "\n${CYAN}►${NC} ${WHITE}PHP-FPM pools:${NC}"
    find /etc/php* -name "*.conf" -path "*/fpm/pool.d/*" 2>/dev/null | while read pool; do
        pool_name=$(basename "$pool" .conf)
        echo -e "  ${GREEN}$pool_name${NC}"
    done
fi

# --------------------------------------------
# 5. PHP COMPOSER
# --------------------------------------------
print_header "COMPOSER"

if command -v composer &>/dev/null; then
    composer_version=$(composer --version 2>/dev/null)
    print_info "Composer" "$composer_version"
    
    # Check composer.json in common locations
    echo -e "\n${CYAN}►${NC} ${WHITE}Composer projects:${NC}"
    for dir in "/var/www" "/home" "/var/www/html" "/var/www/public"; do
        if [ -f "$dir/composer.json" ]; then
            echo -e "  ${GREEN}$dir/composer.json${NC}"
        fi
    done
else
    print_warning "Composer not installed"
fi

# --------------------------------------------
# 6. PHP PERFORMANCE
# --------------------------------------------
print_header "PERFORMANCE"

# Simple performance test
if command -v php &>/dev/null; then
    echo -e "${CYAN}►${NC} ${WHITE}PHP execution time test:${NC}"
    start=$(date +%s%N)
    php -r "for(\$i=0;\$i<100000;\$i++){}" 2>/dev/null
    end=$(date +%s%N)
    time_ms=$(echo "scale=2; ($end - $start) / 1000000" | bc)
    echo -e "  ${WHITE}${time_ms}ms${NC} (100,000 iterations)"
    
    # Memory usage
    memory_usage=$(php -r "echo memory_get_usage();" 2>/dev/null)
    if [ -n "$memory_usage" ]; then
        memory_h=$(numfmt --to=iec "$memory_usage" 2>/dev/null || echo "$memory_usage bytes")
        echo -e "  ${WHITE}Memory usage:${NC} ${CYAN}$memory_h${NC}"
    fi
fi

# --------------------------------------------
# 7. PHP RECOMMENDATIONS
# --------------------------------------------
print_header "RECOMMENDATIONS"

if command -v php &>/dev/null; then
    memory_limit=$(php -r "echo ini_get('memory_limit');" 2>/dev/null)
    mem_val=$(echo "$memory_limit" | sed 's/[^0-9]*//g')
    
    if [ "$mem_val" -lt 256 ]; then
        echo -e "  ${YELLOW}→${NC} Increase memory_limit to at least 256M (current: $memory_limit)"
    fi
    
    upload_max=$(php -r "echo ini_get('upload_max_filesize');" 2>/dev/null)
    if [ "$(echo "$upload_max" | sed 's/[^0-9]*//g')" -lt 32 ]; then
        echo -e "  ${YELLOW}→${NC} Consider increasing upload_max_filesize (current: $upload_max)"
    fi
    
    if [ "$(php -r "echo ini_get('display_errors');" 2>/dev/null)" = "1" ]; then
        echo -e "  ${YELLOW}→${NC} Disable display_errors in production environment"
    fi
    
    if [ "$(php -r "echo ini_get('date.timezone');" 2>/dev/null)" = "" ]; then
        echo -e "  ${YELLOW}→${NC} Set date.timezone in php.ini"
    fi
fi

echo -e "\n${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${GREEN}✓ PHP information complete${NC}"
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}\n"